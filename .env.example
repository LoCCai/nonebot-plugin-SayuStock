# SayuStock QWeb 分支示例环境变量（复制为 .env 后按需修改）

DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
COMMAND_START=["/", ""]
SUPERUSERS=["你的QQ号"]
NICKNAME=["早柚", "Sayu"]

# QWeb 页面：仅在宿主提供 src.qi_web.dependencies 时挂载
# 登录、成员身份、管理员权限与 CSRF 均由 QWeb 宿主负责。
SAYUSTOCK_WEB_ENABLED=true
SAYUSTOCK_PUBLIC_BASE_URL=

# 行情与数据目录（可选）
SAYUSTOCK_DATA_DIR=
SAYUSTOCK_MARKET_CHAIN=东方财富,腾讯财经,新浪财经

# 存储：独立部署默认 file；七七显式 postgres。
# PG 连接串复用宿主 src.qi_web.config.get_settings().database_url，不在此配置。
# 仅在测试环境可用 SAYUSTOCK_DATABASE_URL 覆盖；PG 模式不会回退文件。
SAYUSTOCK_STORAGE=file
