# SayuStock NoneBot2 示例环境变量
# 复制为 .env 后按需修改

DRIVER=~fastapi
HOST=0.0.0.0
PORT=8080
COMMAND_START=["/", ""]
SUPERUSERS=["你的QQ号"]
NICKNAME=["早柚", "Sayu"]

# 网页控制台 / QWeb 基座
SAYUSTOCK_WEB_ENABLED=true
SAYUSTOCK_WEB_TOKEN=请替换为随机长令牌
SAYUSTOCK_PUBLIC_BASE_URL=

# 行情与数据目录（可选）
SAYUSTOCK_DATA_DIR=
SAYUSTOCK_MARKET_CHAIN=东方财富,腾讯财经,新浪财经

# 网页 AI（OpenAI Chat Completions 兼容）
SAYUSTOCK_LLM_BASE_URL=
SAYUSTOCK_LLM_API_KEY=
SAYUSTOCK_LLM_MODEL=